DATABASE_URL=postgresql://actionhub:actionhub_dev@postgres:5432/actionhub
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=zap-events
KAFKA_GROUP_ID=main-worker
SMTP_ENDPOINT=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
# Sender address on your verified Resend domain.
SMTP_FROM=notifications@your-verified-domain.example

# Keep authentication and TLS enabled for Resend.
SMTP_AUTH=true
SMTP_REQUIRE_TLS=true

# Same private encryption key as API/hooks; required for saved provider connections.
CREDENTIAL_ENCRYPTION_KEY=
