KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=zap-events
KAFKA_GROUP_ID=main-worker
SMTP_ENDPOINT=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional sender; defaults to SMTP_USERNAME.
SMTP_FROM=

# Keep true for real providers. Compose disables these only for internal Mailpit.
SMTP_AUTH=true
SMTP_REQUIRE_TLS=true
