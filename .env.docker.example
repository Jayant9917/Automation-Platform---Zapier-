# Docker Desktop development only. Copy to .env.docker and set a private JWT secret.
WEB_PORT=8080
MAIL_PORT=8025
JWT_PASSWORD=
# PostgreSQL and SMTP are internal development services; no production credentials needed.

# 32 random bytes represented as 64 hex characters; keep stable and private.
CREDENTIAL_ENCRYPTION_KEY=

# Optional one-workflow import of a GitHub webhook secret.
GITHUB_SECRETS=
GITHUB_SETUP_WORKFLOW_ID=
