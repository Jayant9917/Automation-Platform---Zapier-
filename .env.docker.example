# Docker Desktop development. Copy to .env.docker and set JWT, encryption and Resend SMTP secrets.
WEB_PORT=8080
JWT_PASSWORD=
# PostgreSQL is internal. Email uses your verified Resend sending domain.

# 32 random bytes represented as 64 hex characters; keep stable and private.
CREDENTIAL_ENCRYPTION_KEY=

# Optional one-workflow import of a GitHub webhook secret.
GITHUB_SECRETS=
GITHUB_SETUP_WORKFLOW_ID=

# Show and enable manual test events only in development.
APP_ENV=development

# Resend SMTP: never commit the real password or API key.
SMTP_ENDPOINT=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=notifications@your-verified-domain.example
