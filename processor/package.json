{
  "name": "processor",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand",
    "start": "node dist/index.js",
    "build": "npm run generate && tsc && node scripts/copy-prisma-engine.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "test:unit": "jest --runInBand",
    "test:ci": "jest --ci --runInBand --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "6.19.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "kafkajs": "^2.2.4",
    "prisma": "6.19.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsx": "^4.21.0",
    "jest": "29.7.0",
    "ts-jest": "29.4.5",
    "eslint": "8.57.1",
    "@typescript-eslint/parser": "8.46.1",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "prettier": "3.6.2",
    "eslint-config-prettier": "10.1.8"
  }
}
