PORT=3000
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/actionhub
# Set a private random value before starting; no built-in fallback.
JWT_PASSWORD=

# 32 random bytes represented as 64 hex characters; keep stable and private.
CREDENTIAL_ENCRYPTION_KEY=

# Optional one-workflow import of a GitHub webhook secret.
GITHUB_SECRETS=
GITHUB_SETUP_WORKFLOW_ID=
