{
  "name": "primary-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "prisma": {
    "seed": "npx tsx seed.ts"
  },
  "scripts": {
    "test": "jest --runInBand",
    "build": "npm run generate && tsc && node scripts/copy-prisma-engine.js",
    "copy-prisma-engine": "node scripts/copy-prisma-engine.js",
    "start": "node dist/index.js",
    "seed": "prisma db seed",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "test:unit": "jest --runInBand",
    "test:ci": "jest --ci --runInBand --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "6.19.2",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "6.19.2",
    "typescript": "^5.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.2.1",
    "tsx": "^4.19.2",
    "jest": "29.7.0",
    "ts-jest": "29.4.5",
    "eslint": "8.57.1",
    "@typescript-eslint/parser": "8.46.1",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "prettier": "3.6.2",
    "eslint-config-prettier": "10.1.8"
  }
}
